@using Microsoft.AspNetCore.Mvc.Localization
@using WebServicesLab1
@using WebServicesLab1.Models
@model IEnumerable<MenuItem>
@inject IHtmlLocalizer<SharedResource> Loc

<ul class="rd-navbar-nav">
    @foreach (var item in Model)
    {
        <li class="rd-nav-item">
            <a class="rd-nav-link" asp-controller="@item.Controller" asp-action="@item.Action">@Loc[item.LocalizationKey]</a>
        </li>
    }
    <li class="rd-nav-item">
        <div style="display: inline-block; padding: 15px 10px;">
            <partial name="_SelectLanguagePartial" />
        </div>
    </li>
</ul>