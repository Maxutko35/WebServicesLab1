@model List<string>
@{
    ViewData["Title"] = "Список завантажених файлів";
}

<div class="container mt-5">
    <h2 class="text-center">Файли на сервері (wwwroot/Files)</h2>
    
    <div class="text-center mb-4 mt-3">
        <a asp-controller="Files" asp-action="Upload" class="btn btn-success">Завантажити ще один файл</a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <ul class="list-group w-50 mx-auto">
            @foreach (var file in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @file
                    <a asp-controller="Files" asp-action="ViewFile" asp-route-filename="@file" target="_blank" class="btn btn-sm btn-info text-white">Переглянути</a>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-center text-muted">Папка порожня. Завантажте перший файл.</p>
    }
</div>